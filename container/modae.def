Bootstrap: docker
#From: ubuntu:22.04
From: tensorflow/tensorflow:2.19.0 
#From: nvcr.io/nvidia/tensorflow:25.02-tf2-py3

%files
    ../../MODAEplus /MODAE

%post
    mkdir /data
    mkdir /scripts
    mkdir /output
    pip install --no-cache-dir /MODAE
	pip install --no-cache-dir matplotlib seaborn

%environment
    export MODAE_DATA_PATH=/data
    export MODAE_SCRIPT_PATH=/scripts
    export MODAE_OUTPUT_PATH=/output
    export TF_CPP_MIN_LOG_LEVEL=2

%runscript
    exec python3 -m modae.training_program "$@"
