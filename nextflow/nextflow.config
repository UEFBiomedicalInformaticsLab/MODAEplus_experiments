params.MODAE_DATA_PATH = './'
params.MODAE_OUTPUT_PATH = './'

docker.enabled = false
apptainer.enabled = true
apptainer.runOptions = [
    "--bind ${params.MODAE_DATA_PATH}:/data",
    "--bind ${params.MODAE_OUTPUT_PATH}:/output"
] 

process {
    executor = 'slurm'
    memory = 1.GB
    withName: 'MODAE_setup' {
        memory = 1.GB
    }
    withName: 'MODAE_HPO' {

    }
    withName: 'MODAE_BA_evaluation' {

    }

    resourceLimits = [
        memory: 450.GB,
        cpus: 96,
        time: 3.d
    ]
}

params {
    
}